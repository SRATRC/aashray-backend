PORT=3000
SESSION_SECRET=your-session-secret

DB_HOST=your-db-host
DB_PORT=your-db-port
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

SES_SMTP_PORT=
SES_SMTP_HOST=
SES_SMTP_EMAIL=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

SECRET=your-secret

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

AWS_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
# Support ticket media: a separate PRIVATE bucket (create it with scripts/setup-ticket-bucket.js)
AWS_S3_TICKET_BUCKET=your-ticket-bucket-name
# Local S3 emulator only (LocalStack, MinIO); leave unset in production
# AWS_S3_ENDPOINT=http://127.0.0.1:4566
# Bucket CORS origins used by scripts/setup-ticket-bucket.js. Keep '*': the staff
# panel's media redirect arrives with Origin: null, so a named origin fails.
# TICKET_CORS_ORIGINS=*

# WhatsApp (Meta Cloud API) — required for OTP + booking/wifi notifications
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/<phone-number-id>/messages
WHATSAPP_BEARER_TOKEN=your-whatsapp-bearer-token
WHATSAPP_DEFAULT_LANG=en
# Phone (with country code) that receives the low-wifi-code admin alert
WIFI_ALERT_PHONE=919819988657
