<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Booking Cancellation</title>
    
    {{> styles }}
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://i.imgur.com/SkOGGbd.png" alt="Company Logo">
        </div>
        <div class="content">
            <h1>Booking Cancelled</h1>
            <p>Dear {{name}},</p>
            <p>You have cancelled your Raj Sharan booking. Here are the details of your cancelled booking:</p>
            <div class="details">
                <p><strong>Booking ID:</strong> {{bookingid}}</p>
                <p><strong>Original Check-In Date:</strong> {{checkin}}</p>
                <p><strong>Original Check-out Date:</strong> {{checkout}}</p>
            </div>
            <p>If you have any questions or need further assistance, please feel free to contact us at <b>+91-7875432613 / +91-9004273512</b>.</p>
        </div>

        {{> _footer}}
    </div>
</body>
</html>
