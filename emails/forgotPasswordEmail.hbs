<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmation</title>
    
    {{> styles }}
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://i.imgur.com/SkOGGbd.png" alt="Company Logo">
        </div>
        <div class="content" >
            <h1>Temporary Password was created!</h1>
            <p class="intro">Dear {{name}},</p> 
            <p class="intro">Your temporary password is: <strong>{{password}}</strong></p>
            <p class="intro">Please change your password after logging in.You can change your password by clicking on the "Update Password" option in the profile section.</p>
        </div>

        {{> _footer}}
    </div>
  </body>
</html>