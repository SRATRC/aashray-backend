<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Booking Confirmation</title>
    {{> styles }}
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://i.imgur.com/SkOGGbd.png" alt="Company Logo">
        </div>
        <div class="content">
            <h1>Added to waitlist!</h1>
            <p>Dear {{name}},</p>
            <p>We are pleased to inform you that your booking has been added to waitlist as per following details:</p>
            <div class="details">
                <p><strong>Booking ID:</strong> {{bookingid}}</p>
                <p><strong>Check-In Date:</strong> {{checkin}}</p>
                <p><strong>Check-out Date:</strong> {{checkout}}</p>
            </div>
        </div>
        <div class="footer">
            &copy; 2025 SRATRC. All rights reserved.
        </div>
    </div>
</body>
</html>
