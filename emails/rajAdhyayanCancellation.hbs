<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Booking Cancellation</title>
    {{> styles }}
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="https://i.imgur.com/SkOGGbd.png" alt="Company Logo">
        </div>
        <div class="content">
            <h1>Booking Cancelled</h1>
            <p>Dear {{name}},</p>
            <p>We regret to inform you that your booking for Raj Adhyayan - <b>{{adhyayanName}}</b> has been cancelled.</p>
            <p>If you have any further questions or need assistance, please feel free to contact us at <b>+91-7875432613 / +91-9004273512</b>.</p>
        </div>

        {{> _footer}}
    </div>
</body>
</html>
